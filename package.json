{
  "name": "mock-exam",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "import:pdf": "node scripts/import-pdf-questions.mjs",
    "import:pdf:check": "node scripts/import-pdf-questions.mjs --dry-run",
    "migrate:explanations": "node scripts/migrate-explanations.mjs",
    "preview": "vite preview",
    "serve": "node scripts/generate-preview-cert.mjs && npm run build && npm run preview"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "pdf-parse": "^2.4.5",
    "react": "latest",
    "react-dom": "latest",
    "typescript": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "selfsigned": "^2.4.1",
    "vite-plugin-pwa": "^1.3.0"
  }
}

{
  "name": "mock-exam",
  "private": true,
  "license": "MIT",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "import:pdf": "node scripts/import-pdf-questions.mjs",
    "import:pdf:check": "node scripts/import-pdf-questions.mjs --dry-run",
    "migrate:explanations": "node scripts/migrate-explanations.mjs",
    "preview": "vite preview",
    "serve": "node scripts/generate-preview-cert.mjs && npm run build && npm run preview",
    "generate:icons": "pwa-assets-generator"
  },
  "dependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vite-pwa/assets-generator": "^1.0.4",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "pdf-parse": "^2.4.5",
    "prettier": "3.10.1",
    "selfsigned": "^2.4.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.1.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.1.0"
  }
}
